GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
FRONTEND_ORIGIN=http://localhost:5173
# Set to true only for deterministic local UI testing; it never calls Gemini.
BUSBOARD_DEMO_MODE=false
# Optional deterministic board text in demo mode; otherwise the selected destination is used.
BUSBOARD_DEMO_DESTINATION=
# Sarvam Bulbul v3 is used for local result playback (ml-IN and en-IN).
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
